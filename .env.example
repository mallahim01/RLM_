# Copy this file to `.env` and fill in your key.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# `.env` is gitignored. Never commit real credentials.

# --- required (unless you run with --mock) ---
# Unprefixed because the OpenAI SDK reads this name by convention.
OPENAI_API_KEY=sk-your-key-here

# --- everything below is optional; these are the defaults ---

# Model used for every RLM call. Any chat model supporting JSON response format.
RLM_MODEL=gpt-4o-mini

# The WORKING CONTEXT BUDGET, in tokens: how much document text goes into any one
# model call. This is NOT your model's context window -- it is the amount you are
# willing to put in front of the model at a time, chosen for accuracy and cost.
# Model quality degrades as context grows ("context rot") well before the window
# is full, so a smaller budget here is a quality decision, not a workaround.
# Lower = more, smaller, sharper calls. Higher = fewer, larger ones.
RLM_MAX_CONTEXT_TOKENS=1500

# Target size of a leaf chunk, and the overlap carried between hard-split parts.
RLM_CHUNK_TARGET_TOKENS=600
RLM_CHUNK_OVERLAP=60

# Recursion safety limits. Three independent guards against runaway cost.
RLM_MAX_DEPTH=3
RLM_MAX_ITERATIONS=2
RLM_MAX_LLM_CALLS=25

# How many sections the router may pick per round.
RLM_MAX_SELECTIONS_PER_ROUND=3

# Caps on the index the router sees, and when lexical pre-filtering kicks in.
RLM_MAX_INDEX_TOKENS=800
RLM_MAX_INDEX_ENTRIES=12
RLM_PREFILTER_THRESHOLD=12

# `auto` uses tiktoken when available and falls back to a chars/4 estimate.
# `heuristic` forces the estimate (deterministic, no network).
RLM_TOKENIZER=auto

# DEBUG | INFO | WARNING | ERROR
RLM_LOG_LEVEL=INFO
